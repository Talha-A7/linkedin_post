# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic (console.anthropic.com → API Keys). Server-only, never expose to the browser.
ANTHROPIC_API_KEY=sk-ant-...


# Set to true once LinkedIn (OIDC) is enabled in Supabase → Authentication → Sign In / Providers
NEXT_PUBLIC_LINKEDIN_LOGIN=false


# "api" (default, required for any shared/production use) or "claude-code" (local development only:
# uses the developer's own Claude Code sign-in via `claude -p`).
AI_PROVIDER=api
